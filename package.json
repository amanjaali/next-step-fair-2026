{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && npm run tinymce",
        "dev": "vite",
        "tinymce": "node -e \"const f=require('fs');const p='public/vendor/tinymce';f.mkdirSync(p,{recursive:true});for(const e of ['tinymce.min.js','themes','models','icons','skins','plugins']){f.cpSync('node_modules/tinymce/'+e,p+'/'+e,{recursive:true})}\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@alpinejs/collapse": "^3.15.12",
        "@fontsource/manrope": "^5.3.0",
        "@fontsource/noto-kufi-arabic": "^5.3.0",
        "@fontsource/noto-sans-arabic": "^5.3.0",
        "@fontsource/space-grotesk": "^5.3.0",
        "alpinejs": "^3.15.12",
        "chart.js": "^4.5.1",
        "html5-qrcode": "^2.3.8",
        "tinymce": "^8.8.2"
    }
}