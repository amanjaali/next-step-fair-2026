APP_NAME="Next Step Fair 2026"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nextstepfair.com
APP_TIMEZONE=Asia/Baghdad

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database — MySQL 8.0+ with utf8mb4. Kurdish and Arabic content needs utf8mb4.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nextstep
DB_USERNAME=nextstep
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Where generated badges live. Use s3 in production so downloads are signed URLs.
BADGE_DISK=public

# Redis is recommended for the outbound message queue and rate limiting.
QUEUE_CONNECTION=database
CACHE_STORE=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail — conference RSVP confirmations carry the badge PDF. Verify the sending
# domain and configure SPF, DKIM and DMARC before go-live.
# For Resend: MAIL_MAILER=resend and set RESEND_KEY.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="conference@nextstepfair.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# WhatsApp — badge delivery and event messages.
#
# Three drivers: log (writes to the delivery log, calls nobody), otpiq (the
# provider used in Iraq and Kurdistan), cloud_api (Meta directly).
#
# Keep WHATSAPP_DRIVER=log until the templates are approved and the keys are in.
# The queue, the delivery log and the admin's retry behave identically against
# the log driver, so the whole flow can be checked before a message is spent.
# ---------------------------------------------------------------------------
WHATSAPP_DRIVER=log

# --- OTPIQ (see docs/whatsapp-otpiq.md) ------------------------------------
# The key is from the OTPIQ dashboard; the two ids are from the WhatsApp account
# inside it, not from Meta. The secret is invented here and pasted into the
# webhook settings there — it is what tells a real delivery report from a
# stranger posting to a public address.
OTPIQ_API_KEY=
OTPIQ_WHATSAPP_ACCOUNT_ID=
OTPIQ_WHATSAPP_PHONE_ID=
OTPIQ_WEBHOOK_SECRET=
# Turn these on only when OTPIQ confirm the account and the approved template
# take a header image and a URL button parameter.
OTPIQ_SEND_HEADER_IMAGE=false
OTPIQ_SEND_BUTTON_LINK=false

# --- Meta Cloud API, for an account we hold ourselves ----------------------
WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
OTP_SMS_FALLBACK=false

# ---------------------------------------------------------------------------
# Ticket QR signing secret. Generate with: php artisan nextstep:qr-secret
# Rotating this invalidates every issued badge — regenerate badges after a change.
# ---------------------------------------------------------------------------
TICKET_QR_SECRET=

# Bot protection on the public form endpoints.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics — conversion events fire on registration completion.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=

VITE_APP_NAME="${APP_NAME}"
